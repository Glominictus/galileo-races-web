---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RaceCheckout from '@/components/checkout/RaceCheckout';
import { getRacePortalClient } from '@/lib/race-portal/index.server';
import { RacePortalError } from '@/lib/race-portal/client';
import { resolveSessionAccount } from '@/lib/api-response';

const { slug } = Astro.params;
let race;

try {
  race = await getRacePortalClient().getRace(slug ?? '');
} catch (error) {
  if (error instanceof RacePortalError && error.status === 404) {
    return Astro.redirect('/404');
  }
  throw error;
}

const { account } = await resolveSessionAccount(Astro.cookies);
const initialModalityId = Astro.url.searchParams.get('modality') ?? undefined;
---

<BaseLayout
  title={`Inscripción · ${race.name} — PULSO`}
  description={`Inscripción oficial para ${race.name}`}
  image={race.imageUrl}
  noindex
  noScrollMobile={true}
>
  <RaceCheckout race={race} initialAccount={account} initialModalityId={initialModalityId} client:load />
</BaseLayout>
