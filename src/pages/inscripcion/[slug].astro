---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RaceCheckout from '@/components/RaceCheckout';
import { getRacePortalClient } from '@/lib/race-portal/index.server';
import { RacePortalError } from '@/lib/race-portal/client';
import { getSessionToken, getStoredAccount } from '@/lib/api-response';

const { slug } = Astro.params;
let race;

try {
  race = await getRacePortalClient().getRace(slug ?? '');
} catch (error) {
  if (error instanceof RacePortalError && error.status === 404) {
    return Astro.redirect('/404');
  }
  throw error;
}

const sessionToken = getSessionToken(Astro.cookies);
const storedAccount = getStoredAccount(Astro.cookies);
let account = storedAccount;

if (sessionToken && !account) {
  try {
    account = await getRacePortalClient().getAccount(sessionToken);
  } catch (error) {
    console.warn('No se pudo cargar la cuenta para el checkout:', error);
  }
}

const initialModalityId = Astro.url.searchParams.get('modality') ?? undefined;
---

<BaseLayout
  title={`Inscripción · ${race.name} — PULSO`}
  description={`Inscripción oficial para ${race.name}`}
  image={race.imageUrl}
  noindex
  noScrollMobile={true}
>
  <RaceCheckout race={race} initialAccount={account} initialModalityId={initialModalityId} client:load />
</BaseLayout>
