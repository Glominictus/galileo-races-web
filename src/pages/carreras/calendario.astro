---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EventCalendar from "@/components/EventCalendar";
import { getRacePortalClient } from "@/lib/race-portal/index.server";

const { items } = await getRacePortalClient().listRaces();
---

<BaseLayout
  title="Calendario Mensual — PULSO"
  description="Consulta las fechas y estados de inscripción de las carreras en Galicia."
  noScrollMobile
>
  <section class="page-heading">
    <span class="section-index">Calendario</span>
    <h1>Visualiza las fechas<br /><em>y su disponibilidad.</em></h1>
    <p>
      Sigue el estado de las inscripciones mes a mes.
    </p>
  </section>

  <section class="calendar-section">
    <EventCalendar races={items} client:load />
  </section>
</BaseLayout>

<style>
  .page-heading {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 5vw, 5rem) 2rem;
    background: var(--ink, #050707);
    color: var(--white, #ffffff);
  }

  .page-heading .section-index {
    color: #ff6b00;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .page-heading h1 {
    font-size: clamp(3.5rem, 8vw, 7.5rem) !important;
    line-height: 0.85 !important;
    margin: 1.4rem 0 1.5rem !important;
    letter-spacing: -0.06em !important;
    color: #ffffff !important; 
  }

  .page-heading h1 em {
    font-style: normal !important;
    color: #ff6b00 !important;
  }

  .page-heading p {
    max-width: 38rem;
    color: #a9aba4;
    line-height: 1.6;
    font-size: 1.1rem;
  }

  .calendar-section {
    padding: clamp(2rem, 5vw, 5rem);
    max-width: 82rem;
    margin: 0 auto;
  }

  /* ==========================================================================
     MODO APP MÓVIL SIN SCROLL (<= 768px)
     ========================================================================== */
  @media (max-width: 768px) {
    :global(body.layout--mobile-app) .page-heading {
      padding: 0.65rem 1.25rem;
      flex-shrink: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    :global(body.layout--mobile-app) .page-heading .section-index {
      font-size: 0.68rem;
      letter-spacing: 0.14em;
    }

    :global(body.layout--mobile-app) .page-heading h1 {
      font-size: 1.15rem;
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin: 0.2rem 0 0;
      font-weight: 800;
    }

    :global(body.layout--mobile-app) .page-heading h1 br {
      display: none;
    }

    :global(body.layout--mobile-app) .page-heading h1 em {
      margin-left: 0.25rem;
    }

    :global(body.layout--mobile-app) .page-heading p {
      display: none;
    }

    :global(body.layout--mobile-app) .calendar-section {
      padding: 0.65rem 0.85rem;
      margin: 0;
      width: 100%;
      flex: 1 1 0%;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    :global(body.layout--mobile-app) .calendar-widget {
      padding: 0.75rem;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      background: #0f1624;
    }

    :global(body.layout--mobile-app) .calendar-header {
      margin-bottom: 0.45rem;
    }

    :global(body.layout--mobile-app) .calendar-header h2 {
      font-size: 1.2rem;
    }

    :global(body.layout--mobile-app) .calendar-nav-btn {
      width: 2.2rem;
      height: 2.2rem;
      font-size: 0.95rem;
    }

    :global(body.layout--mobile-app) .calendar-legend {
      gap: 0.5rem 0.75rem;
      margin-bottom: 0.45rem;
      font-size: 0.7rem;
      justify-content: center;
    }

    :global(body.layout--mobile-app) .calendar-weekdays {
      margin-bottom: 0.25rem;
      padding-bottom: 0.25rem;
      font-size: 0.68rem;
    }

    :global(body.layout--mobile-app) .calendar-grid {
      gap: 0.2rem;
    }

    :global(body.layout--mobile-app) .calendar-day {
      min-height: 48px;
      padding: 0.2rem 0.15rem;
      border-radius: 6px;
      align-items: center;
    }

    :global(body.layout--mobile-app) .calendar-day.day--has-events {
      background: rgba(249, 115, 22, 0.08);
      border-color: rgba(249, 115, 22, 0.25);
    }

    :global(body.layout--mobile-app) .day-number {
      font-size: 0.75rem;
      margin-bottom: 0.15rem;
    }

    :global(body.layout--mobile-app) .day-events {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 3px;
    }

    :global(body.layout--mobile-app) .event-badge {
      min-width: 18px;
      min-height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      background: transparent;
      border: none;
    }

    :global(body.layout--mobile-app) .badge-dot {
      width: 7px;
      height: 7px;
    }

    :global(body.layout--mobile-app) .badge-name {
      display: none;
    }
  }
</style>
