---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RaceMap from "@/components/RaceMap";
import { getRacePortalClient } from "@/lib/race-portal/index.server";

const { items } = await getRacePortalClient().listRaces();
---

<BaseLayout
  title="Mapa de Carreras — PULSO"
  description="Explora las salidas geolocalizadas por la geografía gallega."
>
  <section class="page-heading">
    <div class="page-heading__content">
      <span class="section-index">01 — Geolocalización</span>
      <h1>Explora las salidas<br /><em>en el mapa.</em></h1>
      <p>
        Encuentra pruebas según su ubicación exacta en Galicia y accede a sus inscripciones.
      </p>
    </div>

  </section>

  <section class="map-section">
    <RaceMap races={items} client:only="react" />
  </section>
</BaseLayout>

<style>
  .page-heading {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 5vw, 5rem) 2rem;
    background: var(--ink, #050707);
    color: var(--white, #ffffff);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
  }

  .page-heading__content {
    max-width: 48rem;
  }

  .page-heading .section-index {
    color: var(--lime, #ccff00);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
  }

  .page-heading h1 {
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.85;
    margin: 1.2rem 0 1.5rem;
    letter-spacing: -0.06em;
  }

  .page-heading h1 em {
    font-style: normal;
    color: var(--lime, #ccff00);
  }

  .page-heading p {
    max-width: 38rem;
    color: #a9aba4;
    line-height: 1.6;
    font-size: 1.1rem;
  }

  .page-heading__image {
    max-width: 280px;
    opacity: 0.85;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .page-heading__image:hover {
    opacity: 1;
    transform: scale(1.03);
  }

  .page-heading__image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 15px rgba(204, 255, 0, 0.15));
  }

  .view-toggle {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 2rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .toggle-btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    color: #a9aba4;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .toggle-btn.active, .toggle-btn:hover {
    background: var(--lime, #ccff00);
    color: var(--ink, #050707);
  }

  .map-section {
    padding: clamp(2rem, 5vw, 5rem);
  }

  @media (max-width: 850px) {
    .page-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .page-heading__image {
      max-width: 180px;
      margin: 0 auto;
    }
  }
</style>