---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRacePortalClient } from "@/lib/race-portal/index.server";
import { RacePortalError } from "@/lib/race-portal/client";
import { formatDate, formatMoney, statusCopy } from "@/lib/format";
import { buildRaceJsonLd } from "@/lib/domain/races/seo";

const { slug } = Astro.params;
let race;
try {
  race = await getRacePortalClient().getRace(slug ?? "");
} catch (error) {
  if (error instanceof RacePortalError && error.status === 404)
    return Astro.redirect("/404");
  throw error;
}

const hasOpen = race.modalities.some((item) => item.status === "open");
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const jsonLd = buildRaceJsonLd(race, siteUrl);
---

<BaseLayout
  title={`${race.name} — PULSO`}
  description={race.seoDescription}
  image={race.imageUrl}
  jsonLd={jsonLd}
>
  <section class="race-hero">
    <img src={race.imageUrl} alt={`Corredores en ${race.name}`} /><div
      class="race-hero__overlay"
    >
    </div><div class="race-hero__content">
      <span>{race.type} · {race.province}</span><h1>{race.name}</h1><p>
        {formatDate(race.startsAt)} · {race.city}
      </p>
      {
        hasOpen && (
          <a class="button button--lime race-hero__cta" href={`/inscripcion/${race.slug}`}>
            Inscribirme ahora <span>→</span>
          </a>
        )
      }
    </div><div class:list={["race-state", `status--${race.status}`]}>
      <i></i>{statusCopy[race.status]}
    </div>
  </section>
  <section class="race-intro">
    <span class="section-index">La prueba</span><p>{race.description}</p><div
      class="race-facts"
    >
      <div>
        <span>Distancias</span><strong>{race.distanceLabel}</strong>
      </div><div>
        <span>Desde</span><strong>{formatMoney(race.priceFrom)}</strong>
      </div><div>
        <span>Organiza</span><strong>{race.organizer.name}</strong>
      </div>
    </div>
  </section>
  <section class="race-modalities">
    <header class="modalities-intro">
      <span class="section-index">Modalidades</span>
      <h2>
        Elige tu<br />propio ritmo.
      </h2>
    </header>
    <div class="modalities-scroll-container">
      <div class="modalities-list">
        {
          race.modalities.map((item, index) => (
            <article class="modality-row">
              {
                item.status === 'open' && (
                  <a
                    class="modality-card-link"
                    href={`/inscripcion/${race.slug}?modality=${item.id}`}
                    aria-label={`Inscribirme en ${item.name}`}
                  />
                )
              }
              <!-- Columna 1: Índice y Distancia en grande -->
              <div class="modality-distance">
                <span class="modality-index">0{index + 1}</span>
                <strong>
                  {item.distanceKm.toLocaleString("es-ES")}
                  <small> km</small>
                </strong>
              </div>
              <div class="modality-info">
                <h3>{item.name}</h3>
                <p>
                  {formatDate(item.startAt, {
                    hour: "2-digit",
                    minute: "2-digit",
                  })}
                </p>
                <span class:list={["status", `status--${item.status}`]}>
                  <i />
                  {item.status === "open"
                    ? `${item.availablePlaces} plazas`
                    : statusCopy[item.status]}
                </span>
              </div>
              <div class="modality-price">
                <b>{formatMoney(item.priceFrom)}</b>
                {
                  item.status === 'open' && (
                    <>
                      <a class="button button--lime button--sm" href={`/inscripcion/${race.slug}?modality=${item.id}`}>
                        Inscribirme <span>→</span>
                      </a>
                      <span class="modality-mobile-cta" aria-hidden="true">
                        Seleccionar <span>→</span>
                      </span>
                    </>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="race-detail">
    <div>
      <span class="section-index">Horario</span><h2>Todo a<br />su tiempo.</h2>
    </div><ol>
      {
        race.schedule.map((item) => (
          <li>
            <>
              <time>{item.time}</time>
              <span>{item.label}</span>
            </>
          </li>
        ))
      }
    </ol><div class="included">
      <span class="section-index">Tu inscripción incluye</span><ul>
        {race.included.map((item) => <li>↗ {item}</li>)}
      </ul>
    </div>
  </section>
  <section class="race-cta">
    <div>
      <span class="section-index"
        >{race.city} · {formatDate(race.startsAt)}</span
      ><h2>{hasOpen ? "Nos vemos en la salida." : statusCopy[race.status]}</h2>
    </div>{
      hasOpen ? (
        <a class="button button--lime" href={`/inscripcion/${race.slug}`}>
          Inscribirme ahora <span>→</span>
        </a>
      ) : (
        <a class="button button--lime" href="/carreras">
          Ver otras carreras <span>→</span>
        </a>
      )
    }
  </section>

  {
    hasOpen && (
      <aside class="mobile-sticky-bar" aria-label="Inscripción directa">
        <div class="mobile-sticky-bar__details">
          <span class="mobile-sticky-bar__label">Inscripción oficial</span>
          <span class="mobile-sticky-bar__price">
            Desde <strong>{formatMoney(race.priceFrom)}</strong>
          </span>
        </div>
        <a class="button button--lime mobile-sticky-bar__cta" href={`/inscripcion/${race.slug}`}>
          Inscribirme <span>→</span>
        </a>
      </aside>
    )
  }
</BaseLayout>
<style>
  .race-hero {
    height: calc(100svh - var(--header));
    min-height: 620px;
    position: relative;
    color: var(--white);
    overflow: hidden;
  }
  .race-hero > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .race-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(4, 5, 5, 0.9),
      rgba(4, 5, 5, 0.05) 65%
    );
  }
  .race-hero__content {
    position: absolute;
    left: clamp(1.25rem, 5vw, 5rem);
    bottom: clamp(2rem, 6vw, 6rem);
    max-width: 75rem;
  }
  .race-hero__content > span {
    color: var(--lime);
    text-transform: uppercase;
    letter-spacing: 0.17em;
    font-size: 0.7rem;
  }
  .race-hero h1 {
    font-size: clamp(4.2rem, 10vw, 10rem);
    line-height: 0.82;
    margin: 1rem 0 1.5rem;
    max-width: 11ch;
  }
  .race-hero__content p {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .race-state {
    position: absolute;
    right: 3rem;
    top: 3rem;
    background: var(--white);
    color: var(--ink);
    padding: 0.7rem 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .race-state i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #92958e;
  }
  .race-state.status--open i {
    background: #22c55e;
    animation: status-blink 1.5s ease-in-out infinite;
  }
  .race-state.status--sold-out i {
    background: #ef4444;
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.35);
  }
  .race-intro {
    padding: clamp(6rem, 13vw, 12rem) clamp(1.25rem, 7vw, 7rem);
  }
  .race-intro > p {
    font: 500 clamp(2rem, 4.5vw, 4.5rem)/1.08 "Manrope";
    letter-spacing: -0.05em;
    max-width: 24ch;
    margin: 2rem 0 5rem;
  }
  .race-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .race-facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.5rem;
    border-right: 1px solid var(--line);
  }
  .race-facts > div:last-child {
    border: 0;
  }
  .race-facts span {
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .race-facts strong {
    font: 600 clamp(1.3rem, 2.7vw, 2.5rem) "Manrope";
  }
  .race-modalities {
    background: var(--white);
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 6vw, 6rem);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5vw;
  }
  .race-modalities header h2,
  .race-detail h2 {
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.9;
    margin: 1rem 0;
  }
  .race-modalities article {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto !important;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .modality-index {
    color: var(--muted);
    font-size: 0.7rem;
  }
  .race-modalities article > strong {
    font: 700 2.6rem "Manrope";
  }
  .race-modalities article > strong small {
    font-size: 0.7rem;
  }
  .race-modalities h3 {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
  }
  .race-modalities p {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .race-detail {
    padding: clamp(6rem, 11vw, 11rem) clamp(1.25rem, 7vw, 7rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .race-detail ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .race-detail li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .race-detail time {
    font: 700 1.3rem "Manrope";
  }
  .included {
    grid-column: 2;
    margin-top: 2rem;
  }
  .included ul {
    padding: 1rem 0 0;
    list-style: none;
    columns: 2;
  }
  .included li {
    display: block;
    border: 0;
    padding: 0.5rem 0;
  }
  .race-cta {
    padding: clamp(5rem, 8vw, 8rem) clamp(1.25rem, 6vw, 6rem);
    background: var(--ink);
    color: var(--white);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .race-cta h2 {
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.9;
    margin: 1rem 0 0;
  }
  .race-cta .section-index {
    color: var(--lime);
  }
  .modalities-scroll-container,
  .modalities-list {
    max-height: 520px; 
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .modality-row:last-child {
    border-bottom: 1px solid var(--line, rgba(0, 0, 0, 0.1));
  }
  .modality-price {
    font: 700 1.3rem "Manrope", sans-serif;
    color: var(--ink, #0b1220);
    white-space: nowrap;
    text-align: right; 
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .button--sm {
    padding: 0.5rem 0.9rem;
    font-size: 0.8rem;
    gap: 0.5rem;
    border-radius: 6px;
  }
  .race-hero__cta {
    margin-top: 1.75rem;
    display: inline-flex;
  }
  .modality-card-link,
  .modality-mobile-cta {
    display: none;
  }
  .mobile-sticky-bar {
    display: none;
  }
  @media (max-width: 800px) {
    .race-hero {
      min-height: 440px;
      height: 62svh;
    }
    .race-hero h1 {
      font-size: clamp(2.2rem, 8vw, 3.2rem);
      line-height: 0.95;
      margin: 0.5rem 0 0.75rem;
    }
    .race-hero__content {
      left: 1.25rem;
      right: 1.25rem;
      bottom: 2rem;
      max-width: 100%;
    }
    .race-hero__content p {
      font-size: 0.82rem;
      letter-spacing: 0.08em;
    }
    .race-state {
      right: 1rem;
      top: 1rem;
      padding: 0.45rem 0.85rem;
      font-size: 0.65rem;
      border-radius: 20px;
    }
    .race-hero__cta {
      display: none !important;
    }

    .race-intro {
      padding: 2.75rem 1.25rem 2rem;
    }
    .race-intro > p {
      font: 500 1.25rem/1.35 "Manrope", sans-serif;
      letter-spacing: -0.02em;
      margin: 0.75rem 0 1.75rem;
      max-width: 100%;
    }
    .race-facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      border: none;
    }
    .race-facts > div {
      background: var(--white);
      padding: 0.85rem 0.65rem;
      border-radius: 10px;
      border: 1px solid var(--line);
      gap: 0.35rem;
    }
    .race-facts span {
      font-size: 0.65rem;
      letter-spacing: 0.08em;
    }
    .race-facts strong {
      font-size: 1.05rem;
      line-height: 1.2;
    }

    .race-modalities {
      padding: 2.75rem 1.25rem 2rem;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .modalities-intro h2 {
      font-size: 2rem;
      line-height: 1;
      margin: 0.5rem 0 1.25rem;
    }
    .modalities-scroll-container,
    .modalities-list {
      max-height: none !important;
      overflow: visible !important;
      padding-right: 0;
    }
    .race-modalities article {
      display: grid !important;
      grid-template-columns: 1fr auto !important;
      gap: 0.6rem !important;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.15rem !important;
      margin-bottom: 0.85rem;
    }
    .modality-distance {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }
    .modality-distance strong {
      font: 700 2rem "Manrope", sans-serif;
      color: var(--ink);
    }
    .modality-info {
      grid-column: 1 / -1;
    }
    .modality-info h3 {
      font-size: 1.05rem;
      margin: 0.15rem 0 0.35rem;
    }
    .modality-info p {
      font-size: 0.82rem;
      color: var(--muted);
      margin: 0 0 0.45rem;
    }
    .modality-row {
      position: relative;
    }
    .modality-card-link {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      border-radius: 14px;
    }
    .modality-price {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      border-top: 1px solid var(--line);
      padding-top: 0.75rem;
      margin-top: 0.35rem;
      padding-right: 0 !important;
    }
    .modality-price b {
      font-size: 1.35rem;
      color: var(--ink);
    }
    .modality-price .button--sm {
      display: none !important;
    }
    .modality-mobile-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--lime);
    }

    .race-detail {
      padding: 2.75rem 1.25rem;
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .race-detail h2 {
      font-size: 2rem;
      line-height: 1;
      margin: 0.5rem 0 1.25rem;
    }
    .race-detail li {
      grid-template-columns: 4.5rem 1fr;
      padding: 0.85rem 0;
    }
    .race-detail time {
      font-size: 1.15rem;
    }
    .included {
      grid-column: 1;
      margin-top: 1rem;
    }
    .included ul {
      columns: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-top: 0.75rem;
    }
    .included li {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      font-size: 0.88rem;
      color: var(--ink);
    }

    .race-cta {
      display: block;
      padding: 3rem 1.25rem 5.5rem;
    }
    .race-cta h2 {
      font-size: 2.2rem;
      line-height: 1;
    }
    .race-cta .button {
      display: none !important;
    }

    .mobile-sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 99;
      display: flex !important;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 1.25rem calc(0.8rem + env(safe-area-inset-bottom, 0px)) 1.25rem;
      background: rgba(11, 18, 32, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.3);
    }
    .mobile-sticky-bar__details {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .mobile-sticky-bar__label {
      font-size: 0.68rem;
      color: var(--lime);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
    }
    .mobile-sticky-bar__price {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.8);
    }
    .mobile-sticky-bar__price strong {
      font-size: 1.25rem;
      color: var(--white);
      font-family: 'Manrope', sans-serif;
      font-weight: 800;
    }
    .mobile-sticky-bar__cta {
      padding: 0.65rem 1.25rem;
      font-size: 0.9rem;
      border-radius: 8px;
    }

    /* Espacio compensatorio para que la barra flotante no tape el footer en móvil */
    :global(.site-footer--mobile) {
      padding-bottom: calc(5.2rem + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
</style>
