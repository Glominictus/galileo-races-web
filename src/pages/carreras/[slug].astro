---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRacePortalClient } from '@/lib/race-portal/index.server';
import { RacePortalError } from '@/lib/race-portal/client';
import { formatDate, formatMoney, statusCopy } from '@/lib/format';
const { slug } = Astro.params;
let race;
try { race = await getRacePortalClient().getRace(slug ?? ''); } catch (error) { if (error instanceof RacePortalError && error.status === 404) return Astro.redirect('/404'); throw error; }
const hasOpen = race.modalities.some((item) => item.status === 'open');
const jsonLd = { '@context':'https://schema.org','@type':'SportsEvent',name:race.name,startDate:race.startsAt,eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',image:[new URL(race.imageUrl,import.meta.env.PUBLIC_SITE_URL||Astro.url.origin).toString()],location:{'@type':'Place',name:race.locationName,address:{'@type':'PostalAddress',addressLocality:race.city,addressRegion:race.province,addressCountry:'ES'},geo:{'@type':'GeoCoordinates',latitude:race.latitude,longitude:race.longitude}},organizer:{'@type':'Organization',name:race.organizer.name},offers:race.modalities.map((item)=>({'@type':'Offer',price:item.priceFrom,priceCurrency:'EUR',availability:item.status==='open'?'https://schema.org/InStock':'https://schema.org/SoldOut',url:new URL(`/inscripcion/${race.slug}`,import.meta.env.PUBLIC_SITE_URL||Astro.url.origin).toString()})) };
---
<BaseLayout title={`${race.name} — PULSO`} description={race.seoDescription} image={race.imageUrl} jsonLd={jsonLd}>
  <section class="race-hero"><img src={race.imageUrl} alt={`Corredores en ${race.name}`} /><div class="race-hero__overlay"></div><div class="race-hero__content"><span>{race.type} · {race.province}</span><h1>{race.name}</h1><p>{formatDate(race.startsAt)} · {race.city}</p></div><div class:list={['race-state',`status--${race.status}`]}><i></i>{statusCopy[race.status]}</div></section>
  <section class="race-intro"><span class="section-index">La prueba</span><p>{race.description}</p><div class="race-facts"><div><span>Distancias</span><strong>{race.distanceLabel}</strong></div><div><span>Desde</span><strong>{formatMoney(race.priceFrom)}</strong></div><div><span>Organiza</span><strong>{race.organizer.name}</strong></div></div></section>
  <section class="race-modalities"><header><span class="section-index">Modalidades</span><h2>Elige tu<br />propio ritmo.</h2></header><div>{race.modalities.map((item,index)=><article><span class="modality-index">0{index+1}</span><strong>{item.distanceKm.toLocaleString('es-ES')}<small> km</small></strong><div><h3>{item.name}</h3><p>{formatDate(item.startAt,{hour:'2-digit',minute:'2-digit'})}</p><span class:list={['status',`status--${item.status}`]}><i></i>{item.status==='open'?`${item.availablePlaces} plazas`:statusCopy[item.status]}</span></div><b>{formatMoney(item.priceFrom)}</b></article>)}</div></section>
  <section class="race-detail"><div><span class="section-index">Horario</span><h2>Todo a<br />su tiempo.</h2></div><ol>{race.schedule.map((item)=><li><time>{item.time}</time><span>{item.label}</span></li>)}</ol><div class="included"><span class="section-index">Tu inscripción incluye</span><ul>{race.included.map((item)=><li>↗ {item}</li>)}</ul></div></section>
  <section class="race-cta"><div><span class="section-index">{race.city} · {formatDate(race.startsAt)}</span><h2>{hasOpen?'Nos vemos en la salida.':statusCopy[race.status]}</h2></div>{hasOpen?<a class="button button--lime" href={`/inscripcion/${race.slug}`}>Inscribirme ahora <span>→</span></a>:<a class="button button--lime" href="/carreras">Ver otras carreras <span>→</span></a>}</section>
</BaseLayout>
<style>.race-hero{height:calc(100svh - var(--header));min-height:620px;position:relative;color:var(--white);overflow:hidden}.race-hero>img{width:100%;height:100%;object-fit:cover}.race-hero__overlay{position:absolute;inset:0;background:linear-gradient(0deg,rgba(4,5,5,.9),rgba(4,5,5,.05) 65%)}.race-hero__content{position:absolute;left:clamp(1.25rem,5vw,5rem);bottom:clamp(2rem,6vw,6rem);max-width:75rem}.race-hero__content>span{color:var(--lime);text-transform:uppercase;letter-spacing:.17em;font-size:.7rem}.race-hero h1{font-size:clamp(4.2rem,10vw,10rem);line-height:.82;margin:1rem 0 1.5rem;max-width:11ch}.race-hero__content p{text-transform:uppercase;letter-spacing:.12em}.race-state{position:absolute;right:3rem;top:3rem;background:var(--white);color:var(--ink);padding:.7rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:.68rem;font-weight:700;display:flex;align-items:center;gap:.5rem}.race-state i{width:.55rem;height:.55rem;border-radius:50%;background:#92958e}.race-state.status--open i{background:#5f9e39}.race-state.status--sold-out i{background:#ce513f}.race-intro{padding:clamp(6rem,13vw,12rem) clamp(1.25rem,7vw,7rem)}.race-intro>p{font:500 clamp(2rem,4.5vw,4.5rem)/1.08 'Manrope';letter-spacing:-.05em;max-width:24ch;margin:2rem 0 5rem}.race-facts{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.race-facts>div{display:flex;flex-direction:column;gap:.7rem;padding:1.5rem;border-right:1px solid var(--line)}.race-facts>div:last-child{border:0}.race-facts span{color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.12em}.race-facts strong{font:600 clamp(1.3rem,2.7vw,2.5rem) 'Manrope'}.race-modalities{background:var(--white);padding:clamp(5rem,10vw,10rem) clamp(1.25rem,6vw,6rem);display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw}.race-modalities header h2,.race-detail h2{font-size:clamp(3rem,6vw,6rem);line-height:.9;margin:1rem 0}.race-modalities article{display:grid;grid-template-columns:2rem 8rem 1fr auto;gap:1.4rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--line)}.modality-index{color:var(--muted);font-size:.7rem}.race-modalities article>strong{font:700 2.6rem 'Manrope'}.race-modalities article>strong small{font-size:.7rem}.race-modalities h3{margin:0 0 .3rem;font-size:1.3rem}.race-modalities p{margin:0 0 .6rem;color:var(--muted);font-size:.8rem}.race-detail{padding:clamp(6rem,11vw,11rem) clamp(1.25rem,7vw,7rem);display:grid;grid-template-columns:1fr 1fr;gap:4rem}.race-detail ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}.race-detail li{display:grid;grid-template-columns:5rem 1fr;padding:1.2rem 0;border-bottom:1px solid var(--line)}.race-detail time{font:700 1.3rem 'Manrope'}.included{grid-column:2;margin-top:2rem}.included ul{padding:1rem 0 0;list-style:none;columns:2}.included li{display:block;border:0;padding:.5rem 0}.race-cta{padding:clamp(5rem,8vw,8rem) clamp(1.25rem,6vw,6rem);background:var(--ink);color:var(--white);display:flex;justify-content:space-between;align-items:flex-end}.race-cta h2{font-size:clamp(3rem,7vw,7rem);line-height:.9;margin:1rem 0 0}.race-cta .section-index{color:var(--lime)}@media(max-width:800px){.race-hero{min-height:650px}.race-hero h1{font-size:4.3rem}.race-state{right:1rem;top:1rem}.race-facts{grid-template-columns:1fr}.race-facts>div{border-right:0;border-bottom:1px solid var(--line)}.race-modalities,.race-detail{grid-template-columns:1fr}.race-modalities article{grid-template-columns:1.5rem 4rem 1fr}.race-modalities article>b{grid-column:3}.race-modalities article>strong{font-size:1.7rem}.included{grid-column:1}.race-cta{display:block}.race-cta .button{margin-top:2rem}.included ul{columns:1}}</style>
