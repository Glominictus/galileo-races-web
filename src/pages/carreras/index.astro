---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CatalogExplorer from '@/components/races/CatalogExplorer';
import { getRacePortalClient } from '@/lib/race-portal/index.server';

const { items } = await getRacePortalClient().listRaces();
const provinces = [...new Set(items.map((race) => race.province))].sort();
---

<BaseLayout
  title="Carreras — PULSO"
  description="Encuentra carreras de asfalto, trail y andainas. Filtra por fecha, provincia y terreno."
>
  <section class="page-heading page-heading--lg">
    <span class="section-index">Calendario</span>
    <h1>Encuentra carreras con<br /><em>algo que contar.</em></h1>
    <p>
      Busca por territorio, distancia o terreno. Galileo confirmará siempre las
      plazas y el precio al inscribirte.
    </p>
  </section>

  <section class="catalog-section">
    <CatalogExplorer
      initialRaces={items}
      provinces={provinces}
      client:load
    />
  </section>
</BaseLayout>

<style>
  .catalog-section {
    padding: clamp(2rem, 5vw, 5rem);
  }
</style>