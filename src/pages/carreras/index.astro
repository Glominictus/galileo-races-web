---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CatalogExplorer from "@/components/races/CatalogExplorer";
import { getRacePortalClient } from "@/lib/race-portal/index.server";

const { items } = await getRacePortalClient().listRaces();
const provinces = [...new Set(items.map((race) => race.province))].sort();
---

<BaseLayout
  title="Carreras oficiales en Galicia 2026 — PULSO"
  description="Encuentra carreras de asfalto, trail y andainas en Galicia. Filtra por fecha, provincia o distancia e inscríbete de forma oficial."
>
  <section class="catalog-section">
    <div class="section-container">
      <div class="catalog-title-bar">
        <div class="catalog-title-bar__heading">
          <span class="section-index">01 — Catálogo</span>
          <h1>Carreras en Galicia <em>2026</em></h1>
        </div>
      </div>

      <CatalogExplorer initialRaces={items} provinces={provinces} client:load />
    </div>
  </section>
</BaseLayout>
