---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RaceRow from "@/components/RaceRow.astro";
import RaceCarousel from "@/components/RaceCarousel";
import { getRacePortalClient } from "@/lib/race-portal/index.server";

const { items } = await getRacePortalClient().listRaces();

// 1. Filtrado de carreras próximas para el carrusel
const upcomingRaces = items
  .filter((race) => new Date(race.startsAt) >= new Date() && race.status !== 'closed')
  .sort((a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime())
  .map((race) => ({
    ...race,
    startsAt: new Date(race.startsAt).toISOString(),
  }));

// 2. Selección de carreras destacadas para la lista principal
const featuredOnly = items.filter((race) => race.featured);
const featuredRaces = (featuredOnly.length >= 6 ? featuredOnly : items).slice(0, 6);
---

<BaseLayout>
  <!-- Hero / Portada -->
  <section class="home-hero">
    <img
      src="/images/hero-running-galicia.png"
      alt="Grupo de corredores avanzando por una carretera de montaña al amanecer"
    />
    <div class="home-hero__veil"></div>
    <div class="home-hero__content">
      <span class="hero-kicker">Carreras · Galicia · 2026</span>
      <h1>
        Encuentra<br />tu próxima<br /><em>salida.</em>
      </h1>
      <p>
        Pruebas con territorio, inscripción clara y todos tus dorsales en un
        solo lugar.
      </p>
      <a class="button button--lime" href="/carreras">
        Explorar carreras <span>→</span>
      </a>
    </div>
    <a class="hero-scroll" href="#proximas">
      <span>Desliza para descubrir</span><i>↓</i>
    </a>
  </section>

  <!-- 01 — Próxima Carrera / Carrusel -->
  <section class="next-race" id="proximas">
    <RaceCarousel races={upcomingRaces} client:load />
  </section>

  <!-- 02 — Destacadas -->
  <section class="home-races" id="destacadas">
    <header class="section-header">
      <div>
        <span class="section-index">02 — Destacadas</span>
        <h2>
          La línea de salida<br />está más cerca.
        </h2>
      </div>
      <a class="text-link" href="/carreras">
        Ver calendario completo <span>↗</span>
      </a>
    </header>
    <div class="race-list">
      {featuredRaces.map((race, index) => (
        <RaceRow race={race} index={index + 1} />
      ))}
    </div>
  </section>

  <!-- 03 — Cuenta -->
  <section class="home-account">
    <div class="home-account__image">
      <img
        src="/images/race-forest-trail.png"
        alt="Dos corredores descendiendo por un sendero entre árboles"
        loading="lazy"
      />
    </div>
    <div class="home-account__copy">
      <span class="section-index">03 — Tu recorrido</span>
      <h2>
        Una cuenta.<br />Todas tus carreras.
      </h2>
      <p>
        Inscripciones, pagos y dorsales de cada organizador, reunidos sin perder
        el vínculo con quien hace posible la prueba.
      </p>
      <a class="button button--dark" href="/acceso">
        Crear mi cuenta <span>→</span>
      </a>
    </div>
  </section>

  <!-- 04 — Mapa -->
  <section class="home-map">
    <div class="home-map__copy">
      <span class="section-index">04 — Geolocalización</span>
      <h2>
        Explora las pruebas<br />en el mapa.
      </h2>
      <p>
        Encuentra salidas por provincia o ayuntamiento en Galicia y accede directamente a sus inscripciones.
      </p>
      <a class="button button--dark" href="/carreras/mapa">
        Ver mapa interactivo <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="home-map__image">
      <img
        src="/images/GaliciaMapaVectorial.jpg"
        alt="Mapa de Galicia con las ubicaciones geolocalizadas de las carreras"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 05 — Cierre -->
  <section class="final-call">
    <span class="section-index">05 — Nos vemos allí</span>
    <h2>
      ¿Cuál será<br />la siguiente?
    </h2>
    <a href="/carreras" class="final-call__link">
      Encontrarla <span>↗</span>
    </a>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    color: var(--white);
  }

  .home-hero > img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(5, 7, 7, 0.93) 0%,
        rgba(5, 7, 7, 0.67) 35%,
        rgba(5, 7, 7, 0.05) 72%
      ),
      linear-gradient(0deg, rgba(5, 7, 7, 0.45), transparent 45%);
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    padding: clamp(3rem, 7vh, 6rem) clamp(1.25rem, 6vw, 6rem);
    max-width: 54rem;
    animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
  }

  .hero-kicker {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--lime);
    font-weight: 700;
  }

  .home-hero h1 {
    font-size: clamp(4.3rem, 10vw, 9.4rem);
    line-height: 0.76;
    margin: 1.5rem 0 2rem;
    letter-spacing: -0.085em;
  }

  .home-hero h1 em {
    font-style: normal;
    color: var(--lime);
  }

  .home-hero p {
    max-width: 31rem;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: #d0d2ca;
  }

  .home-hero .button {
    margin-top: 1.1rem;
  }

  .hero-scroll {
    position: absolute;
    right: clamp(1.2rem, 4vw, 4rem);
    bottom: 2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .hero-scroll i {
    font-style: normal;
    border: 1px solid rgba(255, 255, 255, 0.45);
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .home-races {
    padding: clamp(3rem, 6vw, 6rem) clamp(1.25rem, 5vw, 5rem);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: clamp(2.8rem, 6vw, 6rem);
    line-height: 0.93;
    margin: 0.8rem 0 0;
  }

  .section-header .text-link {
    margin-bottom: 0.7rem;
  }

  .home-account {
    background: var(--white);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 48rem;
  }

  .home-account__image {
    overflow: hidden;
  }

  .home-account__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s ease;
  }

  .home-account__copy {
    padding: clamp(3rem, 8vw, 8rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .home-account h2 {
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.92;
    margin: 1rem 0 2rem;
  }

  .home-account p {
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 34rem;
  }

  .home-account .button {
    align-self: flex-start;
    margin-top: 1rem;
  }

  .home-map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--surface, #111414);
    color: var(--white);
    align-items: center;
  }

  .home-map__copy {
    padding: clamp(3rem, 8vw, 8rem);
  }

  .home-map h2 {
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
    line-height: 0.92;
    margin: 1rem 0 1.5rem;
  }

  .home-map p {
    font-size: 1.08rem;
    line-height: 1.6;
    color: #a9aba4;
    margin-bottom: 2rem;
    max-width: 32rem;
  }

  .home-map__image {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .home-map__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final-call {
    padding: clamp(7rem, 14vw, 14rem) clamp(1.25rem, 7vw, 7rem);
    background: var(--lime);
    position: relative;
  }

  .final-call h2 {
    font-size: clamp(5rem, 13vw, 12rem);
    line-height: 0.78;
    margin: 2rem 0 0;
    letter-spacing: -0.09em;
  }

  .final-call__link {
    position: absolute;
    right: 8vw;
    bottom: 8rem;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--white);
    font-weight: 600;
  }

  .final-call__link span {
    position: absolute;
    right: 2rem;
    top: 1.5rem;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
  }

  @media (max-width: 900px) {
    .home-map {
      grid-template-columns: 1fr;
    }

    .home-map__image {
      max-height: 320px;
    }
  }

  @media (max-width: 800px) {
    .home-hero {
      min-height: 680px;
    }

    .home-hero > img {
      object-position: 62% center;
    }

    .home-hero__veil {
      background: linear-gradient(
        0deg,
        rgba(5, 7, 7, 0.94) 0%,
        rgba(5, 7, 7, 0.6) 65%,
        rgba(5, 7, 7, 0.15)
      );
    }

    .home-hero h1 {
      font-size: clamp(4.2rem, 21vw, 6.5rem);
      margin-top: 5rem;
    }

    .hero-scroll {
      display: none;
    }

    .section-header {
      display: block;
    }

    .section-header .text-link {
      display: inline-block;
      margin-top: 1.5rem;
    }

    .home-account {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .home-account__image {
      height: 22rem;
    }

    .final-call__link {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      height: auto;
      border-radius: 0;
      display: inline-flex;
      gap: 3rem;
      padding: 1rem 1.2rem;
      margin-top: 3rem;
    }

    .final-call__link span {
      position: static;
    }
  }
</style>