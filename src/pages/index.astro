---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RaceCarousel from "@/components/races/RaceCarousel";
import FeaturedRacesGrid from "@/components/races/FeaturedRacesGrid";
import { getRacePortalClient } from "@/lib/race-portal/index.server";
import type { RaceSummary } from "@/lib/race-portal/types";

const { items } = await getRacePortalClient().listRaces();

function toSafeTimestamp(value: string): number | null {
  const time = new Date(value).getTime();
  return Number.isNaN(time) ? null : time;
}

function normalizeRaceDate(race: RaceSummary): RaceSummary {
  const time = toSafeTimestamp(race.startsAt);
  return time === null ? race : { ...race, startsAt: new Date(time).toISOString() };
}

// 1. Carreras para el carrusel de próximas salidas
const now = Date.now();
const upcomingFuture = items
  .filter((race) => {
    const startsAt = toSafeTimestamp(race.startsAt);
    return startsAt !== null && startsAt >= now && race.status !== "closed";
  })
  .sort(
    (a, b) =>
      (toSafeTimestamp(a.startsAt) ?? Number.POSITIVE_INFINITY) -
      (toSafeTimestamp(b.startsAt) ?? Number.POSITIVE_INFINITY),
  );

const upcomingRaces = (
  upcomingFuture.length >= 4
    ? upcomingFuture
    : [
        ...upcomingFuture,
        ...items.filter(
          (r) =>
            r.status !== "closed" && !upcomingFuture.some((u) => u.id === r.id),
        ),
      ]
)
  .slice(0, 5)
  .map(normalizeRaceDate);

// 2. Selección de carreras destacadas
const featuredList = items.filter((race) => race.featured);
const featuredRaces = (featuredList.length >= 6 ? featuredList : items).map(
  normalizeRaceDate,
);
---

<BaseLayout
  title="PULSO — Calendario de Carreras en Galicia 2026"
  description="Encuentra tu próxima carrera en Galicia. Filtra por distancia, provincia o terreno e inscríbete de forma oficial y directa."
>
  <!-- 01 — Próximas Salidas (Carrusel Dinámico con Countdown) -->
  <section class="section-upcoming" id="proximas">
    <div class="section-container">
      <div class="section-header section-header--compact">
        <span class="section-index">01 — Próximas salidas</span>
        <h1 class="section-header-hint">Calendario oficial en Galicia</h1>
      </div>
      <RaceCarousel races={upcomingRaces} client:load />
    </div>
  </section>

  <!-- 02 — Carreras Destacadas en Cards -->
  <section class="section-featured" id="destacadas">
    <div class="section-container">
      <div class="section-header section-header--compact">
        <span class="section-index">02 — Destacadas</span>
        <a class="button button--dark" href="/carreras">
          Explorar todas ({items.length}) <span>→</span>
        </a>
      </div>
      <FeaturedRacesGrid races={featuredRaces} client:load />
    </div>
  </section>

  <!-- 03 — Herramientas Interactivas (Mapa y Calendario) -->
  <section class="section-tools">
    <div class="section-container">
      <div class="section-header section-header--compact">
        <span class="section-index">03 — Explora Galicia</span>
        <span class="section-header-hint">2 formas de encontrar tu reto</span>
      </div>

      <div class="tools-grid">
        <!-- Tarjeta Mapa -->
        <a href="/carreras/mapa" class="tool-card tool-card--map">
          <div class="tool-card__content">
            <span class="tool-tag">Geolocalización</span>
            <h3>Mapa interactivo de carreras</h3>
            <p>
              Descubre qué pruebas se corren cerca de tu concello o provincia en
              el mapa geolocalizado de Galicia.
            </p>
            <span class="tool-action">
              Abrir mapa interactivo <span aria-hidden="true">→</span>
            </span>
          </div>
          <div class="tool-card__visual tool-card__visual--map">
            <img
              src="/images/GaliciaMapaVectorial.jpg"
              alt="Mapa interactivo de Galicia con eventos deportivos"
              loading="lazy"
            />
          </div>
        </a>

        <!-- Tarjeta Calendario -->
        <a href="/carreras/calendario" class="tool-card tool-card--calendar">
          <div class="tool-card__content">
            <span class="tool-tag">Cronograma</span>
            <h3>Calendario mensual 2026</h3>
            <p>
              Planifica tus fines de semana y objetivos deportivos mes a mes con
              todas las fechas confirmadas.
            </p>
            <span class="tool-action">
              Ver calendario por meses <span aria-hidden="true">→</span>
            </span>
          </div>
          <div class="tool-card__visual tool-card__visual--calendar">
            <div class="calendar-preview-graphic">
              <div class="cal-mini-header">
                <span>Galicia 2026</span>
                <span class="cal-status-dot"></span>
              </div>
              <div class="cal-mini-grid">
                <div class="cal-day cal-day--past">V</div>
                <div class="cal-day cal-day--event">S <span>10K</span></div>
                <div class="cal-day cal-day--event cal-day--highlight">
                  D <span>21K</span>
                </div>
                <div class="cal-day">L</div>
                <div class="cal-day">M</div>
                <div class="cal-day cal-day--event">X <span>Trail</span></div>
                <div class="cal-day">J</div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 04 — Cierre / Tu Dorsal en Meta -->
  <section class="final-cta">
    <div class="final-cta__container">
      <span class="section-index">04 — Tu dorsal en meta</span>
      <h2>Tu próximo reto<br />empieza aquí.</h2>
      <p>
        Inscripciones oficiales, confirmación inmediata y todos tus dorsales
        siempre organizados en una sola cuenta.
      </p>

      <div class="final-cta__trust-bar">
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Dorsal digital en el móvil</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Alertas de cambios de tramo</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Inscripciones 100% oficiales</span>
        </div>
      </div>

      <div class="final-cta__actions">
        <a class="button button--accent" href="/carreras">
          Explorar carreras <span>→</span>
        </a>
        <a class="button button--outline" href="/acceso">
          Crear mi cuenta gratuita <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
