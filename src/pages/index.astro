---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RaceRow from '@/components/RaceRow.astro';
import { getRacePortalClient } from '@/lib/race-portal/index.server';
const { items } = await getRacePortalClient().listRaces();
const featured = items.filter((race) => race.featured).slice(0, 3);
---
<BaseLayout>
  <section class="home-hero"><img src="/images/hero-running-galicia.png" alt="Grupo de corredores avanzando por una carretera de montaña al amanecer" /><div class="home-hero__veil"></div><div class="home-hero__content"><span class="hero-kicker">Carreras · Galicia · 2026</span><h1>Encuentra<br />tu próxima<br /><em>salida.</em></h1><p>Pruebas con territorio, inscripción clara y todos tus dorsales en un solo lugar.</p><a class="button button--lime" href="/carreras">Explorar carreras <span>→</span></a></div><a class="hero-scroll" href="#destacadas"><span>Desliza para descubrir</span><i>↓</i></a></section>
  <section class="manifesto"><span class="section-index">01 — El pulso</span><p>No coleccionamos eventos.<br /><strong>Elegimos salidas</strong> que conectan personas y territorio.</p></section>
  <section class="home-races" id="destacadas"><header class="section-header"><div><span class="section-index">02 — Próximamente</span><h2>La línea de salida<br />está más cerca.</h2></div><a class="text-link" href="/carreras">Ver calendario completo <span>↗</span></a></header><div class="race-list">{featured.map((race, index) => <RaceRow race={race} index={index + 1} />)}</div></section>
  <section class="home-account"><div class="home-account__image"><img src="/images/race-forest-trail.png" alt="Dos corredores descendiendo por un sendero entre árboles" loading="lazy" /></div><div class="home-account__copy"><span class="section-index">03 — Tu recorrido</span><h2>Una cuenta.<br />Todas tus carreras.</h2><p>Inscripciones, pagos y dorsales de cada organizador, reunidos sin perder el vínculo con quien hace posible la prueba.</p><a class="button button--dark" href="/acceso">Crear mi cuenta <span>→</span></a></div></section>
  <section class="final-call"><span class="section-index">04 — Nos vemos allí</span><h2>¿Cuál será<br />la siguiente?</h2><a href="/carreras" class="final-call__link">Encontrarla <span>↗</span></a></section>
</BaseLayout>
<style>
  .home-hero{position:relative;height:calc(100svh - var(--header));min-height:620px;color:var(--white);overflow:hidden}.home-hero>img{position:absolute;width:100%;height:100%;object-fit:cover;object-position:center}.home-hero__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,7,7,.93) 0%,rgba(5,7,7,.67) 35%,rgba(5,7,7,.05) 72%),linear-gradient(0deg,rgba(5,7,7,.45),transparent 45%)}.home-hero__content{position:relative;z-index:2;padding:clamp(3rem,7vh,6rem) clamp(1.25rem,6vw,6rem);max-width:54rem;animation:hero-in .9s cubic-bezier(.2,.7,.1,1) both}.hero-kicker{font-size:.7rem;text-transform:uppercase;letter-spacing:.2em;color:var(--lime);font-weight:700}.home-hero h1{font-size:clamp(4.3rem,10vw,9.4rem);line-height:.76;margin:1.5rem 0 2rem;letter-spacing:-.085em}.home-hero h1 em{font-style:normal;color:var(--lime)}.home-hero p{max-width:31rem;font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.5;color:#d0d2ca}.home-hero .button{margin-top:1.1rem}.hero-scroll{position:absolute;right:clamp(1.2rem,4vw,4rem);bottom:2rem;z-index:2;display:flex;align-items:center;gap:1rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.14em}.hero-scroll i{font-style:normal;border:1px solid rgba(255,255,255,.45);width:2.8rem;height:2.8rem;border-radius:50%;display:grid;place-items:center}.manifesto{padding:clamp(6rem,14vw,13rem) clamp(1.25rem,7vw,7rem);display:grid;grid-template-columns:1fr 3fr;gap:2rem}.manifesto p{font:500 clamp(2.3rem,5.4vw,5.4rem)/1.05 'Manrope';letter-spacing:-.055em;max-width:18ch}.manifesto strong{font-weight:500;text-decoration:underline;text-decoration-color:var(--lime);text-decoration-thickness:.18em;text-underline-offset:-.05em}.home-races{padding:0 clamp(1.25rem,5vw,5rem) clamp(7rem,12vw,12rem)}.section-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3rem}.section-header h2{font-size:clamp(2.8rem,6vw,6rem);line-height:.93;margin:.8rem 0 0}.section-header .text-link{margin-bottom:.7rem}.home-account{background:var(--white);display:grid;grid-template-columns:1.15fr .85fr;min-height:48rem}.home-account__image{overflow:hidden}.home-account__image img{width:100%;height:100%;object-fit:cover;transition:transform 1s ease}.home-account:hover img{transform:scale(1.025)}.home-account__copy{padding:clamp(3rem,8vw,8rem);display:flex;flex-direction:column;justify-content:center}.home-account h2{font-size:clamp(3rem,6vw,6rem);line-height:.92;margin:1rem 0 2rem}.home-account p{font-size:1.08rem;line-height:1.6;color:var(--muted);max-width:34rem}.home-account .button{align-self:flex-start;margin-top:1rem}.final-call{padding:clamp(7rem,14vw,14rem) clamp(1.25rem,7vw,7rem);background:var(--lime);position:relative}.final-call h2{font-size:clamp(5rem,13vw,12rem);line-height:.78;margin:2rem 0 0;letter-spacing:-.09em}.final-call__link{position:absolute;right:8vw;bottom:8rem;width:9rem;height:9rem;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--white);font-weight:600}.final-call__link span{position:absolute;right:2rem;top:1.5rem}@keyframes hero-in{from{opacity:0;transform:translateY(2rem)}}@media(max-width:800px){.home-hero{min-height:680px}.home-hero>img{object-position:62% center}.home-hero__veil{background:linear-gradient(0deg,rgba(5,7,7,.94) 0%,rgba(5,7,7,.6) 65%,rgba(5,7,7,.15))}.home-hero h1{font-size:clamp(4.2rem,21vw,6.5rem);margin-top:5rem}.hero-scroll{display:none}.manifesto{grid-template-columns:1fr;padding-top:6rem}.section-header{display:block}.section-header .text-link{display:inline-block;margin-top:1.5rem}.home-account{grid-template-columns:1fr}.home-account__image{height:22rem}.final-call__link{position:relative;right:auto;bottom:auto;width:auto;height:auto;border-radius:0;display:inline-flex;gap:3rem;padding:1rem 1.2rem;margin-top:3rem}.final-call__link span{position:static}}
</style>
