---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="No encontramos esa salida — PULSO" noindex><section class="not-found"><span>404</span><h1>Te has salido<br />del recorrido.</h1><p>La página no existe o la carrera ya no está publicada.</p><a class="button button--lime" href="/carreras">Volver a las carreras <span>→</span></a></section></BaseLayout><style>.not-found{min-height:calc(100svh - var(--header));padding:clamp(3rem,8vw,8rem);display:flex;flex-direction:column;justify-content:center;background:var(--ink);color:var(--white)}.not-found>span{color:var(--lime);font:700 1rem 'Manrope'}.not-found h1{font-size:clamp(4rem,10vw,9rem);line-height:.82;margin:1rem 0 2rem}.not-found p{color:#aaa}.not-found .button{align-self:flex-start;margin-top:1rem}</style>
