---
import BaseLayout from '@/layouts/BaseLayout.astro'; import AuthPanel from '@/components/AuthPanel';
---
<BaseLayout title="Acceso — PULSO" description="Entra o crea tu cuenta PULSO." noindex><section class="access-page"><div class="access-copy"><span class="section-index">Tu cuenta global</span><h1>Un acceso.<br /><em>Todos tus dorsales.</em></h1><p>Tu cuenta PULSO conecta de forma segura con el usuario de cada instalación en Galileo.</p></div><div class="access-form"><AuthPanel client:load /></div></section></BaseLayout><style>.access-page{min-height:calc(100svh - var(--header));display:grid;grid-template-columns:1.15fr .85fr;background:var(--ink);color:var(--white)}.access-copy{padding:clamp(3rem,8vw,8rem);display:flex;justify-content:center;flex-direction:column;background:linear-gradient(90deg,rgba(5,7,7,.9),rgba(5,7,7,.2)),url('/images/hero-running-galicia.png') center/cover}.access-copy .section-index{color:var(--lime)}.access-copy h1{font-size:clamp(3.8rem,7vw,7.3rem);line-height:.84;margin:1.2rem 0 2rem}.access-copy h1 em{font-style:normal;color:var(--lime)}.access-copy p{max-width:32rem;color:#b7b9b1;line-height:1.6}.access-form{display:flex;align-items:center;padding:clamp(1rem,5vw,5rem);background:#deddd5}.access-form>*{width:100%;max-width:35rem;margin:auto}@media(max-width:800px){.access-page{grid-template-columns:1fr}.access-copy{min-height:28rem}.access-form{padding:1rem}}</style>
