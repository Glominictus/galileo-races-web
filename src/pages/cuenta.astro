---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountPanel from '@/components/account/AccountPanel';
import { clearSessionCookies, resolveSessionAccount } from '@/lib/api-response';

const { account } = await resolveSessionAccount(Astro.cookies);

if (!account) {
  clearSessionCookies(Astro.cookies);
  return Astro.redirect('/acceso');
}
---

<BaseLayout title="Mi cuenta — PULSO" description="Tu perfil en PULSO." noindex>
  <section class="account-page">
    <header class="account-header">
      <span class="section-index">Mi PULSO</span>
      <h1>Tu cuenta.</h1>
    </header>

    <AccountPanel account={account} client:load />
  </section>
</BaseLayout>

<style>
  .account-page {
    min-height: calc(100vh - var(--header));
    padding: clamp(3.5rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6rem);
    max-width: 64rem;
    margin: 0 auto;
  }
  .account-header h1 {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.9;
    margin: 0.8rem 0 2.5rem;
  }
</style>