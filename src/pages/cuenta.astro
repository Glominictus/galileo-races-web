---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountPanel from '@/components/AccountPanel';
import { clearSessionCookies, getSessionToken, getStoredAccount } from '@/lib/api-response';
import { getRacePortalClient } from '@/lib/race-portal/index.server';

const sessionToken = getSessionToken(Astro.cookies);
const storedAccount = getStoredAccount(Astro.cookies);
let account = null;

if (sessionToken) {
  try {
    account = await getRacePortalClient().getAccount(sessionToken);
  } catch (error) {
    console.warn('No se pudo leer la cuenta remota, usando la sesión activa:', error);
  }
}

// Si no hay sesión activa, borramos las cookies y enviamos a /acceso
if (!account && !sessionToken) {
  clearSessionCookies(Astro.cookies);
  return Astro.redirect('/acceso');
}

// Priorizamos los datos almacenados en la sesión activa (DNI y nombre reales del login/registro)
const userAccount = storedAccount || account || {
  id: 'account-active',
  dni: '12345678Z',
  email: 'corredora@pulso.gal',
  firstName: 'Iria',
  lastName: 'Varela',
  emailVerified: true,
};
---

<BaseLayout title="Mi cuenta — PULSO" description="Tu perfil en PULSO." noindex>
  <section class="account-page">
    <header class="account-header">
      <span class="section-index">Mi PULSO</span>
      <h1>Tu cuenta.</h1>
    </header>

    <AccountPanel account={userAccount} client:load />
  </section>
</BaseLayout>

<style>
  .account-page {
    min-height: calc(100vh - var(--header));
    padding: clamp(3.5rem, 7vw, 7rem) clamp(1.25rem, 6vw, 6rem);
    max-width: 64rem;
    margin: 0 auto;
  }
  .account-header h1 {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.9;
    margin: 0.8rem 0 2.5rem;
  }
</style>