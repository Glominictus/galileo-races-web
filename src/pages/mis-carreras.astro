---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RegistrationsPanel from '@/components/RegistrationsPanel';
---

<BaseLayout
  title="Mis carreras — PULSO"
  description="Tus inscripciones y dorsales en un solo lugar."
  noindex
>
  <section class="registrations-page">
    <span class="section-index">Cuenta global</span>
    <h1>Mis carreras.</h1>
    <p class="page-lead">
      Inscripciones de todos los organizadores conectados con Galileo.
    </p>

    <RegistrationsPanel client:load />
  </section>
</BaseLayout>

<style>
  .registrations-page {
    min-height: calc(100vh - var(--header));
    padding: clamp(3rem, 6vw, 6rem) clamp(1.25rem, 5vw, 5rem);
    max-width: 80rem;
    margin: 0 auto;
  }

  .registrations-page > h1 {
    font-size: clamp(3.5rem, 7.5vw, 7rem);
    line-height: 0.88;
    margin: 1rem 0;
    letter-spacing: -0.04em;
  }

  .page-lead {
    color: var(--muted);
    margin-bottom: 3rem;
    font-size: 1.1rem;
    max-width: 36rem;
  }
</style>
